#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${CORVANTIUM_CONFIG_HOME:-}" ]]; then
    config_home="$CORVANTIUM_CONFIG_HOME"
else
    xdg_config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
    config_home="$xdg_config_home/corvantium"
fi
compositor="$(command -v Hyprland || command -v hyprland || true)"

if [[ -z "$compositor" ]]; then
    printf '%s\n' 'Corvantium requires Hyprland 0.55 or newer.' >&2
    exit 127
fi
version_line="$("$compositor" --version 2>/dev/null | head -n 1)"
version="$(printf '%s\n' "$version_line" | sed -nE 's/.*([0-9]+)\.([0-9]+)\.([0-9]+).*/\1.\2.\3/p')"
if [[ -z "$version" ]]; then
    printf 'Could not read Hyprland version from: %s\n' "$version_line" >&2
    exit 1
fi
major="${version%%.*}"
minor="${version#*.}"
minor="${minor%%.*}"
if (( major == 0 && minor < 55 )); then
    printf 'Corvantium uses Hyprland Lua config and requires 0.55+. Found %s.\n' "$version" >&2
    exit 1
fi
if ! command -v qs >/dev/null 2>&1; then
    printf '%s\n' 'Corvantium requires Quickshell 0.3 or newer.' >&2
    exit 127
fi
if [[ ! -r "$config_home/hyprland/main.lua" ]]; then
    printf 'Corvantium Hyprland config is missing: %s/hyprland/main.lua\nRun the Corvantium installer from its cloned repository.\n' "$config_home" >&2
    exit 1
fi
if [[ ! -r "$config_home/shell/shell.qml" ]]; then
    printf 'Corvantium shell is missing: %s/shell/shell.qml\nRun the Corvantium installer from its cloned repository.\n' "$config_home" >&2
    exit 1
fi

export CORVANTIUM_CONFIG_HOME="$config_home"
export XDG_SESSION_DESKTOP=Corvantium
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Hyprland
exec "$compositor" --config "$config_home/hyprland/main.lua" "$@"
