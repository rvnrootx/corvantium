#!/usr/bin/env bash
set -euo pipefail

notice() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send --app-name=Corvantium Corvantium "$1" || true
    else
        printf 'Corvantium: %s\n' "$1" >&2
    fi
}
configured_app() {
    local key="$1" config="${CORVANTIUM_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/corvantium}/shell/settings.json" selected path
    selected="$(python3 - "$config" "$key" <<'PY'
import json
import sys
from pathlib import Path

try:
    settings = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
    applications = settings.get("applications", {}) if isinstance(settings, dict) else {}
    selected = applications.get(sys.argv[2], "") if isinstance(applications, dict) else ""
    if isinstance(selected, str):
        print(selected.strip())
except (OSError, ValueError, TypeError):
    pass
PY
)"
    if [[ -n "$selected" ]]; then
        path="$(command -v -- "$selected" 2>/dev/null || true)"
        if [[ -n "$path" && -f "$path" && -x "$path" ]]; then printf '%s\n' "$path"; return 0; fi
        notice "Configured $key '$selected' was not found; trying installed alternatives."
    fi
    shift
    pick "$@"
}
pick() {
    local candidate path
    for candidate in "$@"; do
        path="$(command -v "$candidate" 2>/dev/null || true)"
        if [[ -n "$path" ]]; then printf '%s\n' "$path"; return 0; fi
    done
    return 1
}

case "${1:-}" in
    search)
        app="$(configured_app launcher fuzzel wofi rofi || true)"
        case "${app##*/}" in
            "") notice 'Install fuzzel, wofi, or rofi for application search.' ;;
            fuzzel) exec "$app" ;;
            wofi) exec "$app" --show drun ;;
            rofi) exec "$app" -show drun ;;
            *) exec "$app" ;;
        esac
        ;;
    screen-search)
        for binary in slurp grim tesseract python3; do
            command -v "$binary" >/dev/null 2>&1 || { notice "Screen search needs $binary."; exit 1; }
        done
        region="$(slurp 2>/dev/null)" || exit 0
        [[ -n "$region" ]] || exit 0
        image="$(mktemp --suffix=.png "${TMPDIR:-/tmp}/corvantium-screen-XXXXXX")"
        grim -g "$region" "$image" || { notice 'Could not capture the selected screen region.'; exit 1; }
        text="$(tesseract "$image" stdout 2>/dev/null | python3 -c 'import sys; print(" ".join(sys.stdin.read().split()))')"
        rm -f -- "$image"
        [[ -n "$text" ]] || { notice 'No readable text found in that region.'; exit 1; }
        url="$(python3 -c 'import sys, urllib.parse; print("https://www.google.com/search?q=" + urllib.parse.quote_plus(sys.argv[1]))' "$text")"
        command -v xdg-open >/dev/null 2>&1 || { notice 'Install xdg-utils to open the search in your default browser.'; exit 1; }
        exec xdg-open "$url"
        ;;
    music-identify)
        exec "${CORVANTIUM_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/corvantium}/scripts/corvantium-music-recognize"
        ;;
    screen-ocr)
        for binary in slurp grim tesseract wl-copy; do
            command -v "$binary" >/dev/null 2>&1 || { notice "Screen text copy needs $binary."; exit 1; }
        done
        region="$(slurp 2>/dev/null)" || exit 0
        [[ -n "$region" ]] || exit 0
        image="$(mktemp --suffix=.png "${TMPDIR:-/tmp}/corvantium-ocr-XXXXXX")"
        trap 'rm -f -- "$image"' EXIT
        grim -g "$region" "$image" || { notice 'Could not capture the selected screen region.'; exit 1; }
        text="$(tesseract "$image" stdout 2>/dev/null | python3 -c 'import sys; print(" ".join(sys.stdin.read().split()))')"
        [[ -n "$text" ]] || { notice 'No readable text found in that region.'; exit 1; }
        printf '%s' "$text" | wl-copy
        notice 'Selected screen text copied to the clipboard.'
        ;;
    screen-screenshot)
        for binary in slurp grim wl-copy; do
            command -v "$binary" >/dev/null 2>&1 || { notice "Region screenshot needs $binary."; exit 1; }
        done
        region="$(slurp 2>/dev/null)" || exit 0
        [[ -n "$region" ]] || exit 0
        grim -g "$region" - | wl-copy --type image/png
        notice 'Selected screen region copied to the clipboard.'
        ;;
    clipboard)
        command -v cliphist >/dev/null 2>&1 || { notice 'Clipboard history needs cliphist.'; exit 1; }
        command -v wl-copy >/dev/null 2>&1 || { notice 'Clipboard history needs wl-copy.'; exit 1; }
        if command -v fuzzel >/dev/null 2>&1; then
            selected="$(cliphist list | fuzzel --dmenu --prompt='Clipboard  ›  ')" || exit 0
        elif command -v wofi >/dev/null 2>&1; then
            selected="$(cliphist list | wofi --dmenu --prompt='Clipboard history')" || exit 0
        else
            notice 'Clipboard history needs fuzzel or wofi.'; exit 1
        fi
        [[ -n "$selected" ]] && printf '%s\n' "$selected" | cliphist decode | wl-copy
        ;;
    keybinds)
        if command -v fuzzel >/dev/null 2>&1; then
            printf '%s\n' 'Super tap  · Application search' 'Super + Enter  · Terminal' 'Super + G / Tab  · Quick overlay' 'Super + /  · Keybind list' 'Super + Shift + A  · Circle to Search selected region' 'Super + Shift + X  · Copy text from screen region' 'Super + Shift + G  · Recognize music from audio' 'Super + E / W  · File manager / browser' 'Super + Q  · Close focused window' 'Super + D / F  · Maximize / fullscreen' 'Super + Alt + Space  · Toggle floating' 'Super + arrows  · Focus window' 'Super + Shift + arrows  · Move window' 'Super + 1–0  · Switch workspaces' 'Super + Shift + 1–0  · Move window to workspace' 'Super + Ctrl + arrows  · Change workspace' 'Super + Shift + M  · Mute audio' 'Ctrl + Alt + Delete  · Log out' 'Media keys  · Playback and volume' | fuzzel --dmenu --prompt='Corvantium keys  ›  '
        elif command -v wofi >/dev/null 2>&1; then
            printf '%s\n' 'Super tap  · Application search' 'Super + Enter  · Terminal' 'Super + G / Tab  · Quick overlay' 'Super + /  · Keybind list' 'Super + Shift + A  · Circle to Search selected region' 'Super + Shift + X  · Copy text from screen region' 'Super + Shift + G  · Recognize music from audio' 'Super + E / W  · File manager / browser' 'Super + Q  · Close focused window' 'Super + D / F  · Maximize / fullscreen' 'Super + Alt + Space  · Toggle floating' 'Super + arrows  · Focus window' 'Super + Shift + arrows  · Move window' 'Super + 1–0  · Switch workspaces' 'Super + Shift + 1–0  · Move window to workspace' 'Super + Ctrl + arrows  · Change workspace' 'Super + Shift + M  · Mute audio' 'Ctrl + Alt + Delete  · Log out' 'Media keys  · Playback and volume' | wofi --dmenu --prompt='Corvantium keybindings'
        else notice 'Install fuzzel or wofi to view the keybinding list.'; fi
        ;;
    files)
        app="$(configured_app file_manager dolphin thunar nautilus nemo pcmanfm-qt pcmanfm || true)"
        if [[ -n "$app" ]]; then exec "$app" "$HOME"; fi
        notice 'No supported file manager was found.'
        ;;
    terminal)
        app="$(configured_app terminal kitty foot ghostty alacritty wezterm konsole || true)"
        if [[ -n "$app" ]]; then exec "$app"; fi
        notice 'No supported terminal was found.'
        ;;
    effects)
        app="$(pick easyeffects || true)"
        if [[ -n "$app" ]]; then exec "$app"; fi
        notice 'EasyEffects is not installed. Corvantium leaves system equalization unchanged.'
        ;;
    logout)
        if command -v hyprshutdown >/dev/null 2>&1; then exec hyprshutdown; fi
        if command -v hyprctl >/dev/null 2>&1; then exec hyprctl dispatch exit; fi
        notice 'Could not find hyprshutdown or hyprctl to end the Corvantium session.'
        exit 1
        ;;
    browser)
        shift
        app="$(configured_app browser xdg-open || true)"
        if [[ -n "$app" && -n "${1:-}" ]]; then exec "$app" "$1"; fi
        if [[ -z "${1:-}" ]]; then exec xdg-open about:blank; fi
        notice 'No browser opener was available.'
        ;;
    *)
        notice 'Unknown launch action.'
        exit 2
        ;;
esac
